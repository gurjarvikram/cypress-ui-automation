{
  "name": "cypress-ui-automation",
  "version": "1.0.0",
  "description": "Cypress + Cucumber (BDD) UI automation framework for the Swag Labs demo shop, with Page Object Model, tag-based execution and GitHub Actions CI.",
  "keywords": [
    "cypress",
    "cucumber",
    "bdd",
    "gherkin",
    "page-object-model",
    "test-automation",
    "e2e-testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gurjarvikram/cypress-ui-automation.git"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('cypress/reports', { recursive: true, force: true })\"",
    "pretest": "npm run clean",
    "test": "cypress run",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:smoke": "cypress run --env tags=@smoke",
    "test:regression": "cypress run --env tags=@regression",
    "test:negative": "cypress run --env tags=@negative",
    "test:chrome": "cypress run --browser chrome",
    "test:firefox": "cypress run --browser firefox",
    "test:electron": "cypress run --browser electron",
    "test:headed": "cypress run --headed --no-exit",
    "test:record": "cypress run --record",
    "test:parallel": "cypress run --record --parallel --group parallel-tests"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@faker-js/faker": "^10.0.0",
    "cypress": "^15.0.0",
    "esbuild": "^0.28.0"
  }
}
