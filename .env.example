# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
# Cypress reads any CYPRESS_* variable from the environment automatically.

# Application under test. Overrides `baseUrl` from cypress.config.js.
CYPRESS_BASE_URL=https://www.saucedemo.com

# Cypress Cloud record key — required only for `npm run test:record`
# and `npm run test:parallel`. Get it from your Cypress Cloud project settings.
# In CI this is supplied by the CYPRESS_RECORD_KEY repository secret.
CYPRESS_RECORD_KEY=
