# Copy to `.env` and fill in. `.env` is git-ignored — never commit it.
#
#   cp .env.example .env
#
# `.env` is loaded automatically:
#   - cypress.config.js calls dotenv, which covers CYPRESS_BASE_URL
#   - the record scripts preload dotenv before the Cypress CLI starts, which is
#     what makes CYPRESS_RECORD_KEY visible (the CLI reads it before it ever
#     loads cypress.config.js)
#
# In CI nothing reads .env — GitHub Actions injects these from repository
# secrets instead.

# Application under test. Overrides `baseUrl` in cypress.config.js.
CYPRESS_BASE_URL=https://www.saucedemo.com

# Cypress Cloud record key. Required only by `npm run test:record` and
# `npm run test:parallel`; every other script runs without it.
# Find it in Cypress Cloud under Project Settings > Record Keys.
CYPRESS_RECORD_KEY=
